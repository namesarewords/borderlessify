---
import Logo from "@/components/ui/Logo.astro";
import ToTop from "@/components/widgets/ToTop.astro";

const currentYear = new Date().getFullYear();

const columns = [
  {
    heading: "Product",
    links: [
      { name: "Features", url: "/features" },
      { name: "Download", url: "/download" },
      { name: "Supporter", url: "/pricing" },
      { name: "Changelog", url: "/changelog" },
    ],
  },
  {
    heading: "Company",
    links: [
      { name: "About", url: "/about" },
      { name: "Contact", url: "/contact" },
    ],
  },
  {
    heading: "Get started",
    links: [
      { name: "Download", url: "/download" },
      { name: "Get Supporter", url: "/pricing" },
    ],
  },
];
---

<footer class="border-t border-neutral-800">
  <div class="site-container py-12 md:py-16">
    <!-- Top: brand + link columns -->
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10 mb-12">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-4 text-sm text-neutral-500 leading-relaxed">
          Borderlessify makes any game, app, or window borderless on Windows, even when it doesn't support it natively. Save profiles for your favorite games, switch monitors with global hotkeys, and let automatic detection apply the perfect window setup every time you launch.
        </p>
      </div>

      <nav
        class="grid grid-cols-2 sm:grid-cols-3 gap-8 md:gap-16"
        aria-label="Footer"
      >
        {
          columns.map((column) => (
            <div>
              <h3 class="text-sm font-semibold text-neutral-300 mb-4">{column.heading}</h3>
              <ul class="space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      class="text-sm text-neutral-500 hover:text-primary transition-colors duration-200"
                    >
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-neutral-800 pt-6">
      <p class="text-sm text-neutral-500">
        © {currentYear} Borderlessify. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<ToTop />
