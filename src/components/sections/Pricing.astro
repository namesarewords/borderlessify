---
import Button from "@/components/ui/Button.astro";
import { Check } from "@lucide/astro";

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
}

const {
  title = "Borderlessify Supporter",
  description = "Unlock everything Borderlessify can do.",
  showHeader = true,
} = Astro.props;

const proFeatures = [
  { text: "Global hotkeys", detail: "Ctrl + Alt + B toggles borderless, Ctrl + Alt + < and > move windows between monitors" },
  { text: "Fullscreen support", detail: "Converts real fullscreen windows into borderless, not just windowed" },
  { text: "Save profiles", detail: "Store a layout per game or app and reapply it anytime" },
  { text: "Remember positions & sizes", detail: "Windows come back exactly where you left them" },
  { text: "Multi-monitor support", detail: "Send any window to any monitor instantly" },
  { text: "Batch & app-specific rules", detail: "Arrange game, Discord, and browser in one action" },
  { text: "Themes", detail: "Gradient themes plus animated GIF themes" },
  { text: "Automatic detection", detail: "Launch an app and its profile applies itself" },
];
---

<section class="pricing-section">
  {
    showHeader && (
      <div class="site-container pt-16 md:pt-20" data-aos="fade-up-xs" data-aos-once="true">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-neutral-100 mb-4">{title}</h2>
        <p class="max-w-xl text-neutral-400 leading-relaxed">{description}</p>
      </div>
    )
  }

  <div class={`site-container ${showHeader ? "pt-10 pb-16" : "pb-16"}`}>
    <div
      class="rounded-2xl border border-neutral-800 bg-bg-secondary overflow-hidden"
      data-aos="fade-up-sm"
      data-aos-once="true"
    >
      <!-- Top: price + CTA -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8 p-8 md:p-12 border-b border-neutral-800">
        <div>
          <p class="text-sm font-medium uppercase tracking-widest text-primary mb-2">Supporter</p>
          <div class="flex items-baseline gap-2">
            <span class="text-5xl md:text-6xl font-bold tracking-tight text-white">$4</span>
            <span class="text-neutral-400">/ month</span>
          </div>
          <p class="mt-2 text-sm text-neutral-500">Billed monthly. Cancel anytime.</p>
        </div>
        <div class="flex-shrink-0">
          <Button url="https://borderlessify-worker.namesarewords.workers.dev/api/checkout/public?price_id=price_1U8cvzGTQ1EwIOFpsr7jCok1" type="fill" size="lg">Get Supporter</Button>
        </div>
      </div>

      <!-- Features -->
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6 p-8 md:p-12">
        {
          proFeatures.map((feature) => (
            <li class="flex items-start gap-3">
              <Check class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" />
              <div>
                <span class="block text-sm font-semibold text-neutral-100">{feature.text}</span>
                <span class="block text-sm text-neutral-400 leading-relaxed mt-0.5">{feature.detail}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-6 text-sm text-neutral-500" data-aos="fade-up-xs" data-aos-once="true">
      After subscribing, download Borderlessify and create your account in Settings using the email you subscribed with. Then sign in to unlock Supporter features.
    </p>
  </div>
</section>
