---
---

<!-- Large app screenshot directly below the hero, Obsidian-style -->
<section class="site-container relative z-10 pb-6 md:pb-10">
  <div
    class="rounded-2xl border border-neutral-800 bg-bg-secondary shadow-[0_32px_90px_-30px_rgba(0,0,0,0.8)] overflow-hidden"
    data-aos="fade-up-sm"
    data-aos-once="true"
  >
    <!-- App title bar -->
    <div class="flex items-center gap-3 px-4 py-3 border-b border-neutral-800 bg-[#181818]">
      <img src="/logo.png" alt="" width="18" height="18" loading="eager" class="w-[18px] h-[18px] object-contain" />
      <span class="text-xs font-medium text-neutral-300">Borderlessify</span>
      <div class="ml-auto flex items-center gap-3 text-neutral-600" aria-hidden="true">
        <span class="w-2.5 h-2.5 rounded-full bg-neutral-700"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-neutral-700"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-neutral-700"></span>
      </div>
    </div>

    <img
      src="/images/app-window.svg"
      alt="Borderlessify app window"
      width="1200"
      height="800"
      loading="eager"
      class="block w-full h-auto"
    />
  </div>
</section>
