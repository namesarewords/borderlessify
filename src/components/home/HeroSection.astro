---
import Button from "@/components/ui/Button.astro";
---

<div class="relative z-20 w-full mx-auto">
  <!-- Soft accent glow behind the hero -->
  <div
    class="pointer-events-none absolute left-[12%] top-1/2 -translate-y-1/2 h-[420px] w-[720px] max-w-[80vw] rounded-full bg-primary/20 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative site-container flex flex-col items-start text-left pt-24 pb-16 md:pt-32 md:pb-24"
  >
    <!-- Title -->
    <h1
      class="text-5xl sm:text-6xl md:text-8xl font-sans font-extrabold tracking-tight text-white leading-none mb-6"
      data-aos="fade-up-xs"
      data-aos-once="true"
    >
      Borderlessify
    </h1>

    <!-- Subtitle -->
    <p
      class="text-xl md:text-2xl text-neutral-200 mb-10"
      data-aos="fade-up-xs"
      data-aos-once="true"
      data-aos-delay="100"
    >
      Make any game or window Borderless
    </p>

    <!-- Actions -->
    <div
      class="flex flex-wrap items-center gap-6"
      data-aos="fade-up-sm"
      data-aos-once="true"
      data-aos-delay="200"
    >
      <Button url="#" type="fill" size="lg">Download</Button>
      <a
        href="#plans"
        class="inline-flex items-center gap-1.5 font-medium text-primary hover:text-primary-strong underline-offset-4 hover:underline transition-colors duration-200"
      >
        Become a Supporter!
      </a>
    </div>
  </div>
</div>
