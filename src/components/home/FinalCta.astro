---
import Button from "@/components/ui/Button.astro";
---

<!-- Final CTA band, Obsidian-style -->
<section class="site-container pb-20 md:pb-28 pt-4">
  <div
    class="max-w-3xl rounded-3xl border border-primary/20 bg-bg-secondary px-8 py-14 md:py-20"
    data-aos="fade-up-xs"
    data-aos-once="true"
  >
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-neutral-100 mb-4">
      It's time to go borderless.
    </h2>
    <p class="text-neutral-400 mb-8 leading-relaxed">
      Download Borderlessify and take your windows back. Fullscreen is optional.
    </p>
    <div class="flex flex-wrap items-center gap-6">
      <Button url="#" type="fill" size="lg">Download</Button>
      <a
        href="#plans"
        class="inline-flex items-center gap-1.5 font-medium text-primary hover:text-primary-strong underline-offset-4 hover:underline transition-colors duration-200"
      >
        Become a Supporter!
      </a>
    </div>
  </div>
</section>
