---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
---

<Layout
  title="Page Not Found - Borderlessify"
  description="The page you're looking for doesn't exist."
>
  <main class="site-container flex flex-col items-start justify-center py-32 md:py-48">
    <p class="text-sm font-medium uppercase tracking-widest text-primary mb-4">Error 404</p>

    <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-white mb-6">
      Page not found.
    </h1>

    <p class="max-w-md text-base md:text-lg text-neutral-400 leading-relaxed mb-10">
      The page you're looking for doesn't exist or has been moved.
    </p>

    <div class="flex flex-wrap items-center gap-6">
      <Button url="/" type="fill">Back to Home</Button>
      <a
        href="/contact"
        class="inline-flex items-center gap-1.5 font-medium text-primary hover:text-primary-strong underline-offset-4 hover:underline transition-colors duration-200"
      >
        Contact us
      </a>
    </div>
  </main>
</Layout>
