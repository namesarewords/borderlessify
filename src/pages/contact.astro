---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { Mail } from "@lucide/astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title="Contact - Borderlessify"
  description="Questions, feedback, or bug reports? Get in touch with the Borderlessify team."
>
  <main class="site-container py-24 md:py-36">
    <div class="max-w-xl" data-aos="fade-up-xs" data-aos-once="true">
      <p class="text-sm font-medium uppercase tracking-widest text-primary mb-4">Contact</p>

      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white mb-6">
        Get in touch.
      </h1>

      <p class="text-neutral-400 leading-relaxed mb-10">
        Questions, feedback, or bug reports are all welcome.
      </p>

      <Button url={`mailto:${siteConfig.mail}`} type="fill">
        <Mail size={16} /> Email us
      </Button>
    </div>

    <div
      class="mt-14 max-w-xl rounded-2xl border border-neutral-800 bg-bg-secondary p-6"
      data-aos="fade-up-xs"
      data-aos-once="true"
    >
      <p class="text-sm font-semibold text-neutral-100 mb-1">Reporting a bug?</p>
      <p class="text-sm text-neutral-400 leading-relaxed">
        Include your Windows version and the app you're trying to make borderless so we can reproduce it faster.
      </p>
    </div>
  </main>
</Layout>
