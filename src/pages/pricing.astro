---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import PricingSection from "@/components/sections/Pricing.astro";
import AccordionItem from "@/components/ui/AccordionItem.astro";
import Button from "@/components/ui/Button.astro";
import { Check, X, ArrowRight } from "@lucide/astro";

const comparisonFeatures = [
  { name: "Make windows borderless", free: true, support: true },
  { name: "Resize & position", free: "Basic", support: "Full" },
  { name: "Global hotkeys", free: false, support: true },
  { name: "Fullscreen support", free: false, support: true },
  { name: "Save profiles", free: false, support: true },
  { name: "Remember positions & sizes", free: false, support: true },
  { name: "Multi-monitor support", free: false, support: true },
  { name: "Batch & app-specific rules", free: false, support: true },
  { name: "Automatic detection", free: false, support: true },
  { name: "Themes (GIF & gradient)", free: false, support: true },
  { name: "Support", free: "Community", support: "Priority email" },
];

const faqItems = [
  {
    question: "What does Support include?",
    answer:
      "Everything in Free plus global hotkeys, fullscreen support, saved profiles with remembered positions and sizes, multi-monitor support, batch and app-specific rules, automatic detection, and themes.",
  },
  {
    question: "How much does Support cost?",
    answer:
      "Support is about $4 AUD per month, roughly $3-5 AUD depending on your region. Cancel anytime.",
  },
  {
    question: "Can I upgrade or downgrade later?",
    answer:
      "Anytime. Upgrading unlocks Support features immediately, and downgrading simply stops the next renewal; your Free features keep working.",
  },
  {
    question: "How do I get Support?",
    answer:
      "Email borderlessify@gmail.com and we'll help you out as soon as we can.",
  },
];
---

<Layout
  title="Pricing - Borderlessify"
  description="Simple plans. Start free with Borderlessify, or become a Supporter to unlock hotkeys, profiles, themes and more."
>
  <section class="site-container my-12">
    <PageHeader
      title="Simple plans"
      description="Pick the plan that works for you."
    />
  </section>

  <PricingSection showHeader={false} />

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-8 site-container"></div>

  <!-- Feature Comparison -->
  <section class="site-container py-16 md:py-24" data-aos="fade-up-xs" data-aos-once="true">
    <h2 class="text-3xl font-brand text-center mb-8">Compare plans</h2>
    <div class="max-w-2xl mx-auto overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-dashed border-neutral-200 dark:border-neutral-700">
            <th class="text-left py-4 pr-8 text-sm font-medium text-neutral-500">Feature</th>
            <th class="text-center py-4 px-4 text-sm font-medium text-neutral-500">Free</th>
            <th class="text-center py-4 px-4 text-sm font-medium text-primary">Support</th>
          </tr>
        </thead>
        <tbody>
          {comparisonFeatures.map((feature) => (
            <tr class="border-b border-dashed border-neutral-100 dark:border-neutral-800">
              <td class="py-4 pr-8 text-sm text-neutral-700 dark:text-neutral-300">{feature.name}</td>
              {[feature.free, feature.support].map((val) => (
                <td class="text-center py-4 px-4">
                  {typeof val === 'boolean' ? (
                    val ? (
                      <Check class="w-4 h-4 text-primary mx-auto" />
                    ) : (
                      <X class="w-4 h-4 text-neutral-300 dark:text-neutral-600 mx-auto" />
                    )
                  ) : (
                    <span class="text-sm text-neutral-600 dark:text-neutral-300">{val}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-8 site-container"></div>

  <!-- Pricing FAQ -->
  <section class="py-16 md:py-24 site-container">
    <h2 class="text-3xl font-brand text-center mb-8">Pricing FAQ</h2>
    <div class="max-w-2xl mx-auto" data-aos="fade-up-xs" data-aos-once="true">
      {faqItems.map((item, index) => (
        <AccordionItem question={item.question} answer={item.answer} index={index} />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-24 site-container" data-aos="fade-up-xs" data-aos-once="true">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-brand mb-4">Ready to go borderless?</h2>
      <p class="text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed">
        Download Borderlessify for free, or become a Supporter to unlock everything.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button url="#" type="fill" className="text-lg px-8 py-3">
          Download <ArrowRight size={18} />
        </Button>
        <Button url="/contact" className="text-lg px-8 py-3">
          Contact us
        </Button>
      </div>
    </div>
  </section>
</Layout>
