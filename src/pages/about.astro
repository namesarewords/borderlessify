---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { Heart, Code, Users, GitBranch } from "@lucide/astro";

const timeline = [
  {
    version: "v0.1",
    date: "2026",
    title: "The idea",
    desc: "One annoyance kept coming up: games and apps with no borderless mode. The fix was always buried in settings — or didn't exist at all.",
  },
  {
    version: "v0.2",
    date: "2026",
    title: "The first build",
    desc: "A small Windows utility that could force any window borderless, resize it, and pin it to a monitor. It worked, so it kept growing.",
  },
  {
    version: "v0.3",
    date: "2026",
    title: "Public release",
    desc: "Profiles, hotkeys, multi-monitor support, and automatic detection turned Borderlessify into a full window-management tool.",
  },
  {
    version: "v1.0",
    date: "2026",
    title: "Support plan",
    desc: "Borderlessify stays free for the essentials. Supporters unlock hotkeys, themes, batch rules, and help fund future development.",
  },
];
---

<Layout
  title="About — Borderlessify"
  description="Learn about Borderlessify, the utility that makes any game or window borderless."
>
  <section class="site-container my-12">
    <PageHeader
      title="Windows, your way."
      description="Borderlessify started as a small utility to fix one annoyance: apps and games without a borderless mode."
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <article class="space-y-10">

      <!-- Why we built it -->
      <div data-aos="fade-up-xs" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-4">Why we built Borderlessify</h2>
        <div class="space-y-4 text-neutral-600 dark:text-neutral-300 leading-relaxed">
          <p>
            Plenty of games ship without a borderless window option, and plenty of apps refuse to behave the way you want on a multi-monitor setup. Alt-tabbing out of exclusive fullscreen is slow, and resizing windows by hand every launch gets old fast.
          </p>
          <p>
            Borderlessify fixes that in one click. Make any game or window borderless — even ones without a built-in option — then save the layout so it's applied automatically next time.
          </p>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Values -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-6">What we care about</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Code class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">Lightweight</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">A small footprint that stays out of your way while you play.</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Users class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">User-first design</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Simple enough to use mid-game, powerful enough for battlestations.</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Heart class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">Thoughtful craft</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Every feature earns its place. No bloat, no nagging, no ads.</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <GitBranch class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">Free at the core</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">The essentials are free forever. Support keeps development going.</p>
          </div>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Timeline -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-6">How we got here</h2>
        <div class="relative">
          <div class="absolute left-3 md:left-4 top-1.5 bottom-1.5 w-px bg-neutral-200 dark:bg-neutral-700"></div>
          <ol class="space-y-8">
            {timeline.map((item, i) => (
              <li class="relative pl-10 md:pl-12" data-aos="fade-up-sm" data-aos-delay={i * 80} data-aos-once="true">
                <div class="absolute left-1.5 md:left-2.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>
                <div class="mb-1 flex items-center gap-3 flex-wrap">
                  <Badge variant="primary" size="sm">{item.version}</Badge>
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">{item.date}</span>
                </div>
                <h3 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-1">{item.title}</h3>
                <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">{item.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Get involved -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-4">Get involved</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
          Feedback, bug reports, and feature requests all help shape what comes next. Reach out through the contact page and tell us how you use Borderlessify.
        </p>
      </div>

      <div class="flex flex-wrap gap-4" data-aos="fade-up-xs" data-aos-delay="200" data-aos-once="true">
        <Button url="/contact" type="fill">
          Contact us
        </Button>
        <Button url="/changelog">
          View Changelog
        </Button>
      </div>
    </article>
  </section>
</Layout>
