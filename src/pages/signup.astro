---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Set Your Password - Borderlessify" description="Set your password to activate your Borderlessify Supporter account.">
  <section class="site-container my-12 flex items-center justify-center min-h-[70vh]">
    <div class="w-full max-w-md rounded-2xl border border-neutral-800 bg-bg-secondary p-8 md:p-10" id="signup-card">

      <!-- Loading state -->
      <div id="loading-state" class="text-center py-8">
        <div class="inline-block w-6 h-6 border-2 border-primary border-t-transparent rounded-full animate-spin mb-3"></div>
        <p class="text-sm text-neutral-400">Verifying your payment...</p>
      </div>

      <!-- Signup form (hidden until verified) -->
      <div id="signup-form" class="hidden">
        <h2 class="text-2xl font-bold text-neutral-100 mb-2">Welcome to Supporter!</h2>
        <p class="text-sm text-neutral-400 mb-6">Set your password to activate your account.</p>

        <div class="mb-4">
          <label class="block text-sm font-medium text-neutral-300 mb-1.5">Email</label>
          <input type="email" id="signup-email" readonly
            class="w-full px-4 py-3 rounded-lg bg-neutral-800 border border-neutral-700 text-neutral-300 cursor-not-allowed text-sm" />
        </div>

        <div>
          <label class="block text-sm font-medium text-neutral-300 mb-1.5">Password</label>
          <input type="password" id="signup-password" placeholder="At least 8 characters" autocomplete="new-password"
            class="w-full px-4 py-3 rounded-lg bg-neutral-900 border border-neutral-700 text-neutral-100 placeholder-neutral-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-sm" />
        </div>

        <button id="btn-signup" class="w-full mt-4 py-3 rounded-lg bg-primary text-white font-semibold text-sm hover:bg-primary/90 transition-colors">
          Set Password & Sign In
        </button>

        <p id="signup-error" class="mt-3 text-sm text-red-400 hidden"></p>
      </div>

      <!-- Error state -->
      <div id="error-state" class="hidden text-center py-8">
        <p class="text-sm text-red-400 mb-4" id="error-message"></p>
        <a href="/pricing" class="inline-block px-6 py-2.5 rounded-lg bg-primary text-white font-medium text-sm hover:bg-primary/90 transition-colors">
          Get Supporter
        </a>
      </div>

      <!-- Success state -->
      <div id="success-state" class="hidden text-center py-8">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-900/30 border border-green-800 mb-4">
          <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h2 class="text-xl font-bold text-neutral-100 mb-2">You're all set!</h2>
        <p class="text-sm text-neutral-400 mb-2">Your password has been created.</p>
        <p class="text-sm text-neutral-300 mb-6">Open the <strong>Borderlessify app</strong> on your PC and log in with your email and password to start using Supporter features.</p>
        <p class="text-xs text-neutral-500">If you need to reset your password later, you can do so from the app's settings.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const WORKER = 'https://borderlessify-worker.namesarewords.workers.dev';

  const loadingState = document.getElementById('loading-state')!;
  const signupForm = document.getElementById('signup-form')!;
  const errorState = document.getElementById('error-state')!;
  const successState = document.getElementById('success-state')!;
  const errorMessage = document.getElementById('error-message')!;

  const params = new URLSearchParams(window.location.search);
  const sessionId = params.get('session_id');
  const emailParam = params.get('email');

  function showError(msg: string) {
    loadingState.classList.add('hidden');
    signupForm.classList.add('hidden');
    successState.classList.add('hidden');
    errorState.classList.remove('hidden');
    errorMessage.textContent = msg;
  }

  function showSuccess() {
    loadingState.classList.add('hidden');
    signupForm.classList.add('hidden');
    errorState.classList.add('hidden');
    successState.classList.remove('hidden');
  }

  async function init() {
    if (!sessionId) {
      showError('Invalid link. Please purchase Supporter first.');
      return;
    }

    let email = emailParam;

    if (!email) {
      try {
        const resp = await fetch(`${WORKER}/api/checkout/session/${sessionId}`);
        const data = await resp.json();
        email = data.data?.email;
      } catch {
        // fallback
      }
    }

    if (!email) {
      showError('Could not verify your payment. Please try again or contact support.');
      return;
    }

    loadingState.classList.add('hidden');
    signupForm.classList.remove('hidden');
    (document.getElementById('signup-email') as HTMLInputElement).value = email;
  }

  init();

  document.getElementById('btn-signup')!.addEventListener('click', async () => {
    const password = (document.getElementById('signup-password') as HTMLInputElement).value;
    const errEl = document.getElementById('signup-error')!;
    const btn = document.getElementById('btn-signup')!;

    if (!password || password.length < 8) {
      errEl.textContent = 'Password must be at least 8 characters.';
      errEl.classList.remove('hidden');
      return;
    }

    btn.setAttribute('disabled', 'true');
    btn.textContent = 'Setting password...';
    errEl.classList.add('hidden');

    try {
      const resp = await fetch(`${WORKER}/api/auth/set-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId, password }),
      });
      const data = await resp.json();
      if (!data.success) throw new Error(data.error || 'Failed');

      // Store token for auto sign-in
      if (data.data?.token) {
        localStorage.setItem('borderlessify_token', data.data.token);
      }

      showSuccess();
    } catch (e) {
      errEl.textContent = (e as Error).message;
      errEl.classList.remove('hidden');
    } finally {
      btn.removeAttribute('disabled');
      btn.textContent = 'Set Password & Sign In';
    }
  });

  document.getElementById('signup-password')!.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') document.getElementById('btn-signup')!.click();
  });
</script>
