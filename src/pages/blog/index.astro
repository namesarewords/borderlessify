---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";

const POSTS_PER_PAGE = 6;
const currentPage = 1;
---

LLayout title="Blog â€” RicoFast" description="Latest articles, updates, and insights from the RicoFast team.">
  Lsection class="relative z-20 container mx-auto my-12 px-7 lg:px-0">
    LPageHeader
      title="Blog"
      description="Latest articles, updates, and insights."
    />
  L/section>
  Lsection class="relative z-20 mx-auto my-12 lg:px-0">
    Ldiv class="mt-12">
      LBlogSection
        title=""
        listPage={true}
        pagination={{
          enable: true,
          currentPage: currentPage
        }}
        postsPerPage={POSTS_PER_PAGE}
      />
    L/div>
  L/section>
L/Layout>
